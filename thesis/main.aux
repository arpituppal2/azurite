\@writefile{lot}{\contentsline {table}{\numberline {5.2}{\ignorespaces Banking77 77-way, the public task-level comparison with a third-party Jev run. \emph  {Measured} cells come from \texttt  {scripts/decode\_vs\_score.py} on this machine, over a class-balanced draw of all seventy-seven labels; \emph  {cited} cells come from a third party's run of a hosted API \citep  {ayautomate2026jev}. The score row is the 8{,}000-row fine-tune; the decode row is the 1{,}600-row arm, so the row budgets differ within this table as well as across systems. The two systems were never evaluated on the same rows or the same hardware, so a difference of a few points would prove nothing and a large difference would.\relax }}{35}{table.caption.24}\protected@file@percent }
\newlabel{tab:jev77}{{5.2}{35}{Banking77 77-way, the public task-level comparison with a third-party Jev run. \emph {Measured} cells come from \texttt {scripts/decode\_vs\_score.py} on this machine, over a class-balanced draw of all seventy-seven labels; \emph {cited} cells come from a third party's run of a hosted API \citep {ayautomate2026jev}. The score row is the 8{,}000-row fine-tune; the decode row is the 1{,}600-row arm, so the row budgets differ within this table as well as across systems. The two systems were never evaluated on the same rows or the same hardware, so a difference of a few points would prove nothing and a large difference would.\relax }{table.caption.24}{}}
