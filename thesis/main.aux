\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Accuracy of the mean-pool and message-query heads at three context settings. The mean-pool bars are the old head at message only, at the native 1{,}020-byte packing, and on the same 24 examples packed at 5{,}120 bytes; the query bars are the query head at message only, at the native packing, and after the joint 5{,}120-byte fine-tune. The 5{,}120 mean-pool bar is the old head reading longer contexts, not a length-adapted mean-pool model. The dashed line is Jev's 92.40\% on the same 3{,}080 rows. Values are recomputed from the stored per-example files by \texttt  {thesis/gen\_figures.py}.\relax }}{43}{figure.caption.30}\protected@file@percent }
\newlabel{fig:pooling}{{5.2}{43}{Accuracy of the mean-pool and message-query heads at three context settings. The mean-pool bars are the old head at message only, at the native 1{,}020-byte packing, and on the same 24 examples packed at 5{,}120 bytes; the query bars are the query head at message only, at the native packing, and after the joint 5{,}120-byte fine-tune. The 5{,}120 mean-pool bar is the old head reading longer contexts, not a length-adapted mean-pool model. The dashed line is Jev's \QueryJevPct \% on the same 3{,}080 rows. Values are recomputed from the stored per-example files by \texttt {thesis/gen\_figures.py}.\relax }{figure.caption.30}{}}
