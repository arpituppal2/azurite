\citation{laya2026card}
\@writefile{lot}{\contentsline {table}{\numberline {4.5}{\ignorespaces 9 public tasks at three rungs under one pre-registered recipe: LR $10^{-4}$, exactly 3{,}000 optimizer steps, batch 32, 4{,}000 stratified training rows and 2{,}000 test rows where available (Financial PhraseBank has 1{,}264 train and 1{,}000 test), seed 0, encoder unfrozen, native context of each checkpoint (256 at 14.4M, 1{,}024 at 33.7M and 113.47M). The recipe is identical for every cell; there is no per-task learning rate, step count, row cap or prompt. Every Azurite cell is measured on the dual context-candidate path. The 113.47M column is a single new run from fresh weights over 1{,}134{,}658{,}560 tokens (step 69{,}255), evaluated on the same test rows as the smaller rungs. Cited cells are published or third-party figures, not reproduced. DAIR Emotion and XNLI at the two smaller rungs changed evaluation path in an earlier pass and their former candidate-only values are retired. MASSIVE intent's cited point is Laya's card, not a Jev number. No interval is shown here; 95\% Wilson intervals and exact paired McNemar tests are in \S  \ref  {sec:suite} and \texttt  {results/suite\_large\_113m/COMPARISON.md}. These are cross-harness comparisons, not a head-to-head.\relax }}{24}{table.caption.15}\protected@file@percent }
\newlabel{tab:suite}{{4.5}{24}{9 public tasks at three rungs under one pre-registered recipe: LR $10^{-4}$, exactly 3{,}000 optimizer steps, batch 32, 4{,}000 stratified training rows and 2{,}000 test rows where available (Financial PhraseBank has 1{,}264 train and 1{,}000 test), seed 0, encoder unfrozen, native context of each checkpoint (256 at 14.4M, 1{,}024 at 33.7M and 113.47M). The recipe is identical for every cell; there is no per-task learning rate, step count, row cap or prompt. Every Azurite cell is measured on the dual context-candidate path. The 113.47M column is a single new run from fresh weights over 1{,}134{,}658{,}560 tokens (step 69{,}255), evaluated on the same test rows as the smaller rungs. Cited cells are published or third-party figures, not reproduced. DAIR Emotion and XNLI at the two smaller rungs changed evaluation path in an earlier pass and their former candidate-only values are retired. MASSIVE intent's cited point is Laya's card, not a Jev number. No interval is shown here; 95\% Wilson intervals and exact paired McNemar tests are in \S \ref {sec:suite} and \texttt {results/suite\_large\_113m/COMPARISON.md}. These are cross-harness comparisons, not a head-to-head.\relax }{table.caption.15}{}}
\newlabel{tab:suite@cref}{{[table][5][4]4.5}{[1][23][]24}}
\@writefile{lot}{\contentsline {table}{\numberline {4.6}{\ignorespaces Every 113.47M cell with its 95\% Wilson interval, its gap against the cited point, and the exact paired McNemar test against the 14.4M cell on the same test rows. $K$ is the number of classes, $n$ the number of scored test rows. Verdict is the interval rule: \emph  {above} and \emph  {below} mean the Wilson interval excludes the cited point, \emph  {tie} that it covers it. The last two columns compare the two Azurite rungs directly, not either against the citation. Read from \texttt  {results/suite\_large\_113m/COMPARISON.json}; the generator recomputes every cell and refuses a mismatch.\relax }}{25}{table.caption.16}\protected@file@percent }
\newlabel{tab:suite-ci}{{4.6}{25}{Every 113.47M cell with its 95\% Wilson interval, its gap against the cited point, and the exact paired McNemar test against the 14.4M cell on the same test rows. $K$ is the number of classes, $n$ the number of scored test rows. Verdict is the interval rule: \emph {above} and \emph {below} mean the Wilson interval excludes the cited point, \emph {tie} that it covers it. The last two columns compare the two Azurite rungs directly, not either against the citation. Read from \texttt {results/suite\_large\_113m/COMPARISON.json}; the generator recomputes every cell and refuses a mismatch.\relax }{table.caption.16}{}}
\newlabel{tab:suite-ci@cref}{{[table][6][4]4.6}{[1][25][]25}}
